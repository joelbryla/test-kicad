(ftf
  (header
    (version 2.0)
    (unit DBUNIT)
  )
  (TechnologyContainer
    (technology SamacSys_Footprint
      (footprintLayer
        (layer Top (type Conductive))
        (layer Inner (type Conductive))
        (layer Bottom (type Conductive))
        (layer Silk-Top (type Symbolmark))
        (layer Silk-Bottom (type Symbolmark))
        (layer Resist-Top (type Solderresist))
        (layer Resist-Bottom (type Solderresist))
        (layer MetalMask-Top (type Metalmask))
        (layer MetalMask-Bottom (type Metalmask))
        (layer CompArea-Top (type Comparea))
        (layer CompArea-Bottom (type Comparea))
        (layer Assembly-Top (type Undefined))
        (layer Assembly-Bottom (type Undefined))
        (layer Hole (type Hole))
      )
    )
  )
  (footprintContainer
    (commonParameters
      (dimensionParameters
        (arrowLength 100000)
        (arrowAngle 15.000000)
        (dotDiameter 100000)
        (textFrameOffset 100000)
        (arrowOffset 100000)
        (dimAssistOffset 100000)
        (dimLineWidth 10000)
        (drawTextFrame NO)
        (textFrameRange ALL)
        (textClip NO)
        (standard JIS)
      )
    )
    (padstackGroups
      (padstackGroup default)
    )
    (pads
      (pad r70_30
        (photo FLASH)
        (panelUse NO)
        (geometry
          (rectangle
            (pt 0 0)
            (width 30000)
            (height 70000)
            (rAngle 0.000000)
            (outlineWidth 0)
            (fillWidth 0)
            (fillAngle 0.000000)
          )
        )
      )
      (pad r140_120
        (photo FLASH)
        (panelUse NO)
        (geometry
          (rectangle
            (pt 0 0)
            (width 120000)
            (height 140000)
            (rAngle 0.000000)
            (outlineWidth 0)
            (fillWidth 0)
            (fillAngle 0.000000)
          )
        )
      )
    ); End of pads
    (padstacks
      (padstack r70_30
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r70_30))
          (noconnect (pad r70_30))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r70_30))
          (noconnect (pad r70_30))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r70_30))
          (noconnect (pad r70_30))
        )
      )
      (padstack r140_120
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r140_120))
          (noconnect (pad r140_120))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r140_120))
          (noconnect (pad r140_120))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r140_120))
          (noconnect (pad r140_120))
        )
      )
    ); End of padstacks
    (footprints
      (footprint "INA740BIREMR"
        (polarity YES)
        (panelUse NO)
        (heelprint
          (layout
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -200000 250000
                        (width 10000)
                      )
                      (pt 200000 250000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 200000 250000
                        (width 10000)
                      )
                      (pt 200000 -250000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 200000 -250000
                        (width 10000)
                      )
                      (pt -200000 -250000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -200000 -250000
                        (width 10000)
                      )
                      (pt -200000 250000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer CompArea-Top)
              (area
                (geometry
                  (surface
                    (outlineWidth 0)
                    (fillWidth 0)
                    (fillAngle 0.000000)
                    (vertex
                    (pt 320000 375000)
                    (pt 320000 -375000)
                    (pt -320000 -375000)
                    (pt -320000 375000)
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -260000 210000
                        (width 10000)
                      )
                      (pt -260000 210000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (arc CCW
                        (r 5000)
                        (begin
                          (pt -260000 210000
                            (width 10000)
                          )
                        )
                        (center -1073741824 0)
                        (end
                          (pt -270000 210000
                            (width 10000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (arc CCW
                        (r 5000)
                        (begin
                          (pt -270000 210000
                            (width 10000)
                          )
                        )
                        (center 1073741824 0)
                        (end
                          (pt -260000 210000
                            (width 10000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
           ); End of layout
         ); End of heelprint
         (toeprint
          (pin 1
            (pt -185000 210000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -185000 210000)
                  (angle 90)
                  (padstackGroup default (padstack r70_30))
                )
              )
            )
          )
          (pin 2
            (pt -185000 150000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -185000 150000)
                  (angle 90)
                  (padstackGroup default (padstack r70_30))
                )
              )
            )
          )
          (pin 3
            (pt -185000 30000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -185000 30000)
                  (angle 90)
                  (padstackGroup default (padstack r70_30))
                )
              )
            )
          )
          (pin 4
            (pt -185000 -30000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -185000 -30000)
                  (angle 90)
                  (padstackGroup default (padstack r70_30))
                )
              )
            )
          )
          (pin 5
            (pt -185000 -90000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -185000 -90000)
                  (angle 90)
                  (padstackGroup default (padstack r70_30))
                )
              )
            )
          )
          (pin 6
            (pt -185000 -210000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -185000 -210000)
                  (angle 90)
                  (padstackGroup default (padstack r70_30))
                )
              )
            )
          )
          (pin 7
            (pt 0 -215000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 0 -215000)
                  (angle 90)
                  (padstackGroup default (padstack r140_120))
                )
              )
            )
          )
          (pin 8
            (pt 185000 -210000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 185000 -210000)
                  (angle 90)
                  (padstackGroup default (padstack r70_30))
                )
              )
            )
          )
          (pin 9
            (pt 185000 -150000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 185000 -150000)
                  (angle 90)
                  (padstackGroup default (padstack r70_30))
                )
              )
            )
          )
          (pin 10
            (pt 185000 -30000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 185000 -30000)
                  (angle 90)
                  (padstackGroup default (padstack r70_30))
                )
              )
            )
          )
          (pin 11
            (pt 185000 30000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 185000 30000)
                  (angle 90)
                  (padstackGroup default (padstack r70_30))
                )
              )
            )
          )
          (pin 12
            (pt 185000 90000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 185000 90000)
                  (angle 90)
                  (padstackGroup default (padstack r70_30))
                )
              )
            )
          )
          (pin 13
            (pt 185000 210000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 185000 210000)
                  (angle 90)
                  (padstackGroup default (padstack r70_30))
                )
              )
            )
          )
          (pin 14
            (pt 0 215000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 0 215000)
                  (angle 90)
                  (padstackGroup default (padstack r140_120))
                )
              )
            )
          )
        ); End of toeprint
        (propertyS accurateShape INA750BIREMR.stp)
      ); End of footprint
    ); End of footprints
  );  End of footprintContainer
); End of ftf

